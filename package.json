{
  "name": "tasktracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "electron dist-electron/main.js",
    "build": "tsc && vite build && electron-builder",
    "build:app": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "electron scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.3"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide": "^1.49.0",
    "zod": "^4.6.5"
  },
  "description": "A desktop task tracker with recurring tasks, reminders, a calendar and a completion archive."
}
